# ============================================================
# 本地开发配置模板（本文件提交到仓库，请勿写入真实密码）
#
# 使用方式：
#   1. 复制本文件为同目录下的 application-local.yml
#      Windows: copy application-local.yml.example application-local.yml
#      macOS/Linux: cp application-local.yml.example application-local.yml
#   2. 在 application-local.yml 中填入真实的数据库 / Redis 账号密码
#   3. application-local.yml 已被 .gitignore 忽略，不会提交到仓库
#
# 生效优先级：
#   application-local.yml  >  环境变量 mysql_username / mysql_password
# ============================================================
xueling:
  datasource:
    # 数据库账号（xueling_db 的拥有者）
    username: your_mysql_username
    # 数据库密码
    password: your_mysql_password
  redis:
    # Redis 密码；若 Redis 未设置 requirepass，保持空字符串即可
    password: your_redis_password
